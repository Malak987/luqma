{
  "version": 8,
  "name": "Luqma Dark — Minimal Charcoal",
  "metadata": {
    "openfreemap:provider": "https://tiles.openfreemap.org/planet",
    "luqma:brand": "#7B1E28",
    "luqma:description": "Luqma Dark Minimal Charcoal — deep charcoal #1A1A1A, main roads #2A2A2A, secondary #2E2E2E, minor #3A3A3A, labels #9E9E9E, water #1E2A32, parks #1F2B1F, buildings dark neutral, borders dark-gray, POIs restrained"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#1A1A1A"}},
    {"id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["==", ["get", "class"], "residential"], "paint": {"fill-color": "#252525", "fill-opacity": 0.5}},
    {"id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": {"fill-color": "#1F2B1F", "fill-opacity": 0.7}},
    {"id": "park-outline", "type": "line", "source": "openmaptiles", "source-layer": "park", "paint": {"line-color": "#2A3A2A", "line-width": 0.5, "line-opacity": 0.6}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": {"fill-color": "#1E2A32"}},
    {"id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": {"line-color": "#2A3A4A", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 16, 3]}},
    {"id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": {"fill-color": "#2A2A2A", "fill-opacity": 0.8, "fill-outline-color": "#333333"}},
    {"id": "building-3d", "type": "fill-extrusion", "source": "openmaptiles", "source-layer": "building", "minzoom": 15, "paint": {"fill-extrusion-color": "#333333", "fill-extrusion-height": ["get", "render_height"], "fill-extrusion-opacity": 0.4}},
    {"id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 2], "paint": {"line-color": "#3A3A3A", "line-width": 1, "line-opacity": 0.6}},
    {"id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["==", ["get", "admin_level"], 4], "paint": {"line-color": "#3A3A3A", "line-width": 0.8, "line-dasharray": [2, 2], "line-opacity": 0.4}},
    {"id": "road-minor-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], "minor", "service", "track"], "layout": {"line-join": "round"}, "paint": {"line-color": "#333333", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 8], "line-opacity": 0.9}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], "minor", "service", "track"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#3A3A3A", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 6]}},
    {"id": "road-secondary-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], "secondary", "tertiary"], "layout": {"line-join": "round"}, "paint": {"line-color": "#333333", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 12]}},
    {"id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], "secondary", "tertiary"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#2E2E2E", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 10]}},
    {"id": "road-primary-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "primary"], "layout": {"line-join": "round"}, "paint": {"line-color": "#333333", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 16, 16]}},
    {"id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "primary"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#2A2A2A", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 16, 14]}},
    {"id": "road-trunk-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "trunk"], "layout": {"line-join": "round"}, "paint": {"line-color": "#444444", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 16, 18]}},
    {"id": "road-trunk", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "trunk"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#2A2A2A", "line-width": ["interpolate", ["linear"],["zoom"],5,0.6,16,16]}},
    {"id": "road-motorway-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "motorway"], "layout": {"line-join": "round"}, "paint": {"line-color": "#444444", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 16, 20]}},
    {"id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "motorway"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#2A2A2A", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.6, 16, 18]}},
    {"id": "road-rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "class"], "rail"], "paint": {"line-color": "#3A3A3A", "line-dasharray": [2, 2], "line-width": 1}},
    {"id": "water-label", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12}, "paint": {"text-color": "#6B8291", "text-halo-color": "#1A1A1A", "text-halo-width": 1}},
    {"id": "poi-restrained", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "filter": ["all", ["==", ["get", "rank"], 1]], "minzoom": 15, "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 10, "icon-image": ["get", "subclass"], "icon-size": 0.8}, "paint": {"text-color": "#8A8A8A", "text-halo-color": "#1A1A1A", "text-halo-width": 1}},
    {"id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11, "symbol-placement": "line"}, "paint": {"text-color": "#9E9E9E", "text-halo-color": "#1A1A1A", "text-halo-width": 1}},
    {"id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "city"], "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Medium"], "text-size": 14}, "paint": {"text-color": "#9E9E9E", "text-halo-color": "#1A1A1A", "text-halo-width": 1.2}},
    {"id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "town"], "minzoom": 8, "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11}, "paint": {"text-color": "#8A8A8A", "text-halo-color": "#1A1A1A", "text-halo-width": 1}},
    {"id": "place-village", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "village"], "minzoom": 10, "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 10}, "paint": {"text-color": "#8A8A8A", "text-halo-color": "#1A1A1A", "text-halo-width": 1}}
  ]
}
